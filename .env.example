# research_agent 根配置契约（2026-09-18）。
# cp .env.example .env；真实凭证只填写 .env，禁止提交。
# 当前根 Compose 仅读取基础设施参数；以下云模型/工具参数是待实现目标，
# 尚未全部接通旧子项目。不得仅改模板就宣称完成云端迁移。
# 供应商由用户后续选择；支持的协议以对应 Adapter 为准。

# ---- 本机基础设施（当前根 Compose 已使用；仅为开发默认） ----
POSTGRES_USER=research
POSTGRES_PASSWORD=research
POSTGRES_DB=research_agent
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333

# ---- 云端生成/规划/文本验证，默认共享一个配置 ----
LLM_PROVIDER=
LLM_MODEL=
LLM_MODEL_VERSION=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ---- 云端 embedding；维度必须与所选模型及索引一致，不预设 1024 ----
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_MODEL_VERSION=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSION=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2

# ---- 可选云端 reranker；禁用/失败仅保留 RRF，不加载本地模型 ----
RERANKER_ENABLED=false
RERANKER_PROVIDER=
RERANKER_MODEL=
RERANKER_MODEL_VERSION=
RERANKER_API_KEY=
RERANKER_BASE_URL=
RERANKER_TIMEOUT_SECONDS=30
RERANKER_MAX_RETRIES=2

# ---- 云 OCR；扫描/低质量文本区域所需配置 ----
OCR_PROVIDER=
OCR_MODEL=
OCR_MODEL_VERSION=
OCR_API_KEY=
OCR_BASE_URL=
OCR_TIMEOUT_SECONDS=60
OCR_MAX_RETRIES=2

# ---- 云视觉识别/验证；不可隐式借用其他能力的 key ----
VISION_PROVIDER=
VISION_MODEL=
VISION_MODEL_VERSION=
VISION_API_KEY=
VISION_BASE_URL=
VISION_TIMEOUT_SECONDS=60
VISION_MAX_RETRIES=2

# ---- 搜索来源；arXiv 官方元数据接口不要求 API key ----
SEARCH_ENABLED_SOURCES=kb,tavily,arxiv
SEARCH_TIMEOUT_SECONDS=30
SEARCH_MAX_RETRIES=2
TAVILY_API_KEY=
ARXIV_BASE_URL=https://export.arxiv.org/api/query
ARXIV_MIN_REQUEST_INTERVAL_SECONDS=3

# ---- Agentic RAG 有界执行；retry/fetch/read 也消耗工具预算 ----
AGENT_MAX_ROUNDS=3
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_MODEL_TOKENS=20000
AGENT_DEADLINE_SECONDS=180
AGENT_MAX_CONCURRENCY=4
# 可选美元硬上限；启用前需配置供应商价格表，否则拒绝启动付费任务。
# 空值表示不启用费用硬上限，并非费用为 0；轮数/token/deadline 限制仍生效。
AGENT_MAX_COST_USD=

# ---- 入库文件限制；供应商更严格时取更小值 ----
DOCUMENT_MAX_PAGES=100
DOCUMENT_MAX_UPLOAD_MB=20
IMAGE_MAX_PIXELS=20000000
INGEST_MAX_CONCURRENCY=2

# ---- 云出站授权；模型、rerank、搜索查询及远程 fetch 都受控 ----
# false 时拒绝用户数据外送；来源启用/填写凭证不等于授权。
CLOUD_DATA_UPLOAD_ALLOWED=false
# 按能力/provider/endpoint/model 身份授权，详见 docs/design.md 第 9 节。
# 总开关开启仍需匹配 fingerprint；换 provider/endpoint/model 要重新核准。
CLOUD_DATA_APPROVALS_JSON={}
# 以下记录用户核对的供应商地域/留存说明，不代表能改变供应商政策。
CLOUD_DATA_REGION=
CLOUD_RETENTION_POLICY_NOTE=
# P5 后端加密配置所需主密钥：由用户安全生成，仅经启动环境提供。
CONFIG_ENCRYPTION_KEY=
