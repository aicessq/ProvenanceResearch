# research_agent 根环境变量模板。
#
# 使用方法：
#   cp .env.example .env
#   填入 LLM_* 与 TAVILY_API_KEY，然后 docker compose up -d
#
# 说明：
#   1. .env 已被 .gitignore 忽略，真实密钥不得提交；本文件只放占位值。
#   2. 变量契约见 docs/decisions.md「环境变量契约：统一 LLM_* 三件套」。
#   3. 本文件服务于根 docker-compose.yml 的基础设施与将来的统一应用服务；
#      knowledge_engine 与 researcher 各自的 .env.example 仍保留，用于单独运行子系统。

# ---- PostgreSQL（根 compose） ----
POSTGRES_USER=research
POSTGRES_PASSWORD=research
POSTGRES_DB=research_agent
POSTGRES_PORT=5432

# ---- Redis（根 compose） ----
REDIS_PORT=6379

# ---- Qdrant（根 compose） ----
QDRANT_PORT=6333

# ---- 统一 LLM（OpenAI 兼容，迁移期唯一生成模型） ----
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# ---- Embedding / Reranker（迁移期沿用本地句向量模型） ----
EMBEDDING_MODEL_PATH=models/embedding
EMBEDDING_VECTOR_SIZE=1024
RERANKER_MODEL_PATH=models/reranker

# ---- Web 搜索 ----
TAVILY_API_KEY=