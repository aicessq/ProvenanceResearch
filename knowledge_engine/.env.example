# 环境变量示例文件。
#
# 使用方法：
#   cp .env.example .env
# 然后按实际环境修改值。Docker Compose 会自动读取同目录下的 .env。
#
# 设计说明（教学向）
# =================
# 1. 规格 §3.2 要求所有配置从 .env 读取；本文件列出全部可配置项及默认值。
# 2. 本地直接跑 uvicorn 时用 localhost；在 docker compose 内运行时，
#    docker-compose.yml 已用服务名（postgres/redis/qdrant）覆盖 *_HOST。
# 3. 切勿把真实密钥提交进仓库；.env 已在 .gitignore 中忽略。

# ---- 通用 ----
DEBUG=false

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cybersec
POSTGRES_PASSWORD=cybersec
POSTGRES_DB=cybersec_rag

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# 本地开发默认无密码；生产请设置强密码
REDIS_PASSWORD=

# ---- Celery Worker 与异步任务恢复 ----
CELERY_WORKER_PING_TIMEOUT_SECONDS=2
CELERY_WORKER_REGISTRATION_CACHE_SECONDS=30
QUEUED_STALE_SECONDS=300
DISPATCHED_QUEUE_STALE_SECONDS=900
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
PROCESSING_LEASE_TIMEOUT_SECONDS=180
TASK_RECOVERY_INTERVAL_SECONDS=60
TASK_RECOVERY_BATCH_SIZE=50
TASK_MAX_RECOVERY_COUNT=3
TASK_AUTO_RECOVER_PROCESSING=false
TASK_STATUS_REDIS_TTL_SECONDS=86400

# ---- Qdrant ----
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=cybersec_chunks
QDRANT_DISTANCE_METRIC=Cosine

# ---- Phase 2：上传与本地存储 ----
STORAGE_ROOT=storage
MAX_UPLOAD_SIZE_MB=20
# 逗号分隔；FastAPI 上传时会同时检查扩展名与 MIME
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.md,.markdown,.txt
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,text/markdown,text/plain,text/x-markdown

# ---- Phase 5：本地模型与索引 ----
EMBEDDING_MODEL_PATH=models/embedding
RERANKER_MODEL_PATH=models/reranker
EMBEDDING_VECTOR_SIZE=1024
EMBEDDING_BATCH_SIZE=16
RERANKER_BATCH_SIZE=16
FTS_LANGUAGE_CONFIG=simple

# ---- 后端服务端口 ----
BACKEND_PORT=8000

# ---- 以下为后续 Phase 预留项（Phase 7+ 使用）----
# LLM API key 与 base_url（来自 Doc/LLMAPKKEY.txt，请勿提交真实 key）
LLM_API_KEY=
LLM_BASE_URL=
