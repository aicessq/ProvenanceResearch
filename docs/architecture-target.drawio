  <diagram id="target-arch" name="目标架构">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t_title" value="目标系统拓扑（组件视图 · docs/design.md）&#xa;本图回答“组件部署在哪里、彼此怎么连接”；Agent 自主决策与反馈循环见 architecture-target-agentic-rag-runtime.drawio。绿底 = Q1/Q2 已裁决 · 黄底 = Q3–Q7 推荐待确认 · 其余为 P3a–P5 尚未实现规格" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="zone_t_fe" value="统一前端（P5）" style="swimlane;startSize=24;fillColor=#f5f5f5;strokeColor=#666666;html=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="250" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="t_fe" value="统一研究界面&#xa;对话 / 证据引用 / 任务三栏&#xa;云服务配置 UI（密钥加密存储·&#xa;不入 localStorage/日志/SSE）&#xa;PDF 页跳转 · OCR bbox 定位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_t_fe">
          <mxGeometry x="20" y="50" width="210" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="zone_t_res" value="researcher（Agentic RAG 编排 · 单实例 Q1 已裁决）" style="swimlane;startSize=24;fillColor=#f5f5f5;strokeColor=#666666;html=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="340" y="90" width="950" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="t_api" value="统一公共接口 /api/v1&#xa;problem+json + request_id&#xa;版本化 SSE + Last-Event-ID 回放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_t_res">
          <mxGeometry x="20" y="40" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="t_loop" value="Agentic 有界循环&#xa;计划 → 校验工具调用 → 执行 → 登记&#xa;Evidence → 融合 → 缺口判定 → 追加/终止&#xa;预算：3 轮 · 12 次调用 · 20k tokens&#xa;180s deadline · 并发 4 · 循环检测&#xa;无新 Evidence 的重复调用不重试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_t_res">
          <mxGeometry x="270" y="40" width="270" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t_exec" value="工具执行器&#xa;白名单 + JSON Schema 参数校验&#xa;预算 / 取消 / deadline&#xa;单源失败不取消健康源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_t_res">
          <mxGeometry x="580" y="40" width="330" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="t_tools" value="kb_search · web_search ·&#xa;arxiv_search · source_fetch ·&#xa;evidence_read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_t_res">
          <mxGeometry x="580" y="210" width="330" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="t_reg" value="Source Registry&#xa;provider 能力/健康/限额&#xa;arXiv 3s 节流&#xa;（单进程信号量 · Q1 已裁决）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="zone_t_res">
          <mxGeometry x="20" y="200" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="t_evid" value="统一 Evidence 池（版本化）&#xa;provenance / locator / extraction&#xa;raw_text / citation_id（K/W/A/I）&#xa;检索内容 = 不可信数据&#xa;不提升为系统指令" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_t_res">
          <mxGeometry x="270" y="270" width="270" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="t_adapter" value="Cloud Model Adapter&#xa;LLM / EMBEDDING / RERANKER / OCR /&#xa;VISION 独立配置 · 密钥绑定 provider&#xa;失败矩阵 · 退避 · deadline&#xa;多 key + 熔断接线（Q4 推荐·待确认）&#xa;删跨槽位 key 兜底（E3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="zone_t_res">
          <mxGeometry x="270" y="450" width="270" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="t_reader" value="Reader 融合&#xa;RRF 确定性基线&#xa;（KB 权重 1.0 / 外部 0.7·top-8）&#xa;+ 可选云 rerank&#xa;无本地 reranker 回退" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_t_res">
          <mxGeometry x="20" y="380" width="220" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="t_gate" value="引用闸门&#xa;span 文本验证 + 语义复检&#xa;视觉断言→云 vision 验证原区域&#xa;重生成 1 次仍失败 → 拒答&#xa;answered/refused 与任务态分离" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_t_res">
          <mxGeometry x="20" y="560" width="220" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="t_evlog" value="SSE 事件日志&#xa;Q3 推荐（待确认）：每任务一条&#xa;Redis Stream · TTL 7d&#xa;Last-Event-ID = stream entry id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="zone_t_res">
          <mxGeometry x="270" y="660" width="270" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="zone_t_ke" value="knowledge_engine（证据层 · Celery 多进程 Q1 已裁决）" style="swimlane;startSize=24;fillColor=#f5f5f5;strokeColor=#666666;html=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1340" y="90" width="580" height="900" as="geometry"/>
