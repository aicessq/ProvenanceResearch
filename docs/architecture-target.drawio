        <mxCell id="t_kb" value="内部 KB 检索接口&#xa;固定内部地址（不可被搜索结果指定）&#xa;vector / keyword 两路独立失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_t_ke">
          <mxGeometry x="290" y="40" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="t_ingest" value="入库管线&#xa;PDF 分类：原生文本/扫描/混合&#xa;云 OCR 转录 · 云 vision 观察/推断分离&#xa;parent-child 切分 · 页/bbox/资产溯源&#xa;失败页显式报告 · 不发布残缺版本&#xa;文本层与 OCR 不重复入库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_t_ke">
          <mxGeometry x="20" y="200" width="240" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="t_idx" value="索引版本管理&#xa;embedding_identity 绑定&#xa;新 collection 重嵌 → 核验 → 切换&#xa;保留回滚 · 禁止跨身份复用向量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_t_ke">
          <mxGeometry x="290" y="200" width="260" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="t_worker" value="Celery worker / beat&#xa;ingest / control 双队列（Q2 已裁决）&#xa;at-least-once + 计时器心跳&#xa;租约 fencing · 幂等重派&#xa;孤立索引清理&#xa;PROCESSING 自动恢复捆绑心跳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="zone_t_ke">
