          <mxGeometry x="260" y="420" width="210" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="zone_w" value="Worker 进程（Celery prefork ×N · 默认单队列）" style="swimlane;startSize=24;fillColor=#f5f5f5;strokeColor=#666666;html=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="340" y="790" width="660" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="ke_ing" value="ingest_document_task&#xa;claim→解析→清洗→切分&#xa;→嵌入→索引→complete&#xa;心跳 = 阶段间调用（B3）&#xa;acks_late=False（B2）&#xa;Qdrant 先于 db.commit（B4）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="zone_w">
          <mxGeometry x="20" y="40" width="240" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="ke_rec" value="recovery_worker&#xa;queued-stale 重派 ≤3 次&#xa;PROCESSING 过时→failed&#xa;默认不自动重跑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_w">
          <mxGeometry x="300" y="40" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="ke_reidx" value="reindex_worker&#xa;死任务：无任何派发方（B7）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="zone_w">
