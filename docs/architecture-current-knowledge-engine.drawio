        </mxCell>
        <mxCell id="ke_fe" value="React SPA（Vite :5173）&#xa;Dashboard / Upload / Retrieve&#xa;/ Rewrite / Answer / Eval&#xa;&#xa;A1: 全端点无认证&#xa;上传后不轮询任务状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_fe">
