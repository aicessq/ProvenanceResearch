          <mxGeometry x="340" y="90" width="1030" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="ke_api" value="API 层&#xa;POST /documents/upload·replace&#xa;DELETE /documents·GET tasks&#xa;GET /api/v1/query·/api/v1/eval&#xa;admin.py = 空 stub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_be">
          <mxGeometry x="20" y="40" width="210" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="ke_up" value="UploadService&#xa;扩展/MIME/20MB 校验&#xa;advisory lock + file_hash 去重&#xa;写 Document/Version/IngestTask&#xa;提交后派发（task_id 预生成）&#xa;派发失败→标记回滚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_be">
