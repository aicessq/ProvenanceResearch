        </mxCell>
        <mxCell id="dr_router" value="FallbackRouter&#xa;Slot→Cost→Capability→Latency&#xa;静态链·有任意 key 即全部「可用」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_api">
          <mxGeometry x="570" y="460" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="dr_client" value="LLMClient&#xa;httpx AsyncClient 120s&#xa;失败硬抛→整任务失败（E4）&#xa;无重试/退避/429 处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="zone_api">
          <mxGeometry x="840" y="460" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="dr_note" value="重启行为：initialize() 把 RUNNING→FAILED 清孤儿，不恢复（G2）&#xa;错误传播：仅 search 分支 return_exceptions 吞错；其余 agent 失败 = 任务整体失败&#xa;topology/agents YAML 声明的 max_concurrent_searchers、timeout、max_retries 全部未实现（D2/D3）&#xa;models.yaml：6 家供应商（deepseek/glm/moonshot/doubao/ernie/qwen）静态配置" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fillColor=#ffffff;strokeColor=#d6b656;rounded=1;" vertex="1" parent="zone_api">
