        <mxCell id="zone_api" value="FastAPI 进程（uvicorn 单进程 · asyncio 内存态即真相 · 无队列无 broker）" style="swimlane;startSize=24;fillColor=#f5f5f5;strokeColor=#666666;html=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="340" y="90" width="1090" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="dr_rres" value="routes_research&#xa;POST /api/research（异步）&#xa;POST /research/sync&#xa;GET events（SSE）&#xa;DELETE 取消（重启后 404）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_api">
          <mxGeometry x="20" y="40" width="220" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="dr_rmod" value="routes_models&#xa;GET /models/status&#xa;POST /models/test&#xa;接受任意 api_base 出站（A2）&#xa;PUT /models/config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="zone_api">
          <mxGeometry x="270" y="40" width="230" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="dr_rsvc" value="ResearchService（模块单例）&#xa;_tasks/_running/_subscribers&#xa;内存 dict = 运行时真相&#xa;asyncio.create_task(_execute)&#xa;结果缓存 md5·无 TTL 无上限（C3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="zone_api">
          <mxGeometry x="540" y="40" width="260" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="dr_evq" value="事件分发&#xa;每订阅者 asyncio.Queue&#xa;满即丢弃&#xa;C5: 无事件日志→回放不可能" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="zone_api">
          <mxGeometry x="840" y="40" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="dr_graphs" value="LangGraph 拓扑&#xa;hierarchical / debate&#xa;每次构建各自实例化&#xa;池/路由/客户端（E2）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_api">
          <mxGeometry x="20" y="280" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="dr_agents" value="Agents&#xa;Planner → Searchers 并行&#xa;gather·无信号量无超时（D2）&#xa;→ Readers → Analyst → Critic&#xa;→ Writer → Validator&#xa;BaseAgent 花括号刮 JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone_api">
          <mxGeometry x="270" y="280" width="260" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="dr_pool" value="APIKeyPool&#xa;每模型 1 key·轮询退化（E1）&#xa;拿不到→任意槽位 env key 兜底&#xa;跨供应商错配（E3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="zone_api">
